# =============================================
# Prisha Online Documentation — Environment Config
# NEVER commit .env to git. Copy this file to .env and fill in values.
# =============================================

# --- Gemini API (Primary) ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI API (Fallback) ---
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Instagram Graph API ---
# All three are REQUIRED. Get them from Meta Developers:
# https://developers.facebook.com/docs/instagram-api/getting-started

# Long-lived Page access token (valid ~60 days, refresh before expiry)
# Must have: instagram_basic, instagram_content_publish, pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here

# Instagram Business Account ID (numeric)
# Find it via: GET https://graph.facebook.com/v21.0/me/accounts?access_token=TOKEN
INSTAGRAM_BUSINESS_ID=your_instagram_business_id_here

# Facebook Page ID (numeric) — the page linked to your Instagram Business account
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# --- Optional: Override config values ---
# BUSINESS_NAME=Prisha Online Documentation
# WEBSITE=www.prishaonlinedocumentation.com
# CONTACT=+91 98765 43210
